{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*secrets*/**)",
      "Read(**/*credential*)",
      "Read(**/*credentials*/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*secret*)",
      "Edit(**/*secrets*/**)",
      "Edit(**/*credential*)",
      "Edit(**/*credentials*/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep * *.env*)",
      "Bash(cat *secret*)",
      "Bash(cat *credential*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.npmrc)",
      "Bash(cat *.netrc)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Select-String * *.env*)",
      "PowerShell(Get-Content *secret*)",
      "PowerShell(Get-Content *credential*)",
      "PowerShell(Get-Content *.pem)",
      "PowerShell(Get-Content *.key)",
      "PowerShell(Get-Content *id_rsa*)",
      "PowerShell(Get-Content *id_ed25519*)",
      "PowerShell(Get-Content *.npmrc)",
      "PowerShell(Get-Content *.netrc)",
      "PowerShell(Get-Content *.ssh*)",
      "PowerShell(Get-Content *.aws*)"
    ]
  }
}
